# Settings of the home-server stack (ADR-012, docs/04-deployment.md).
# Copy this file to `.env.server` (same folder) and fill in the values marked SECRET:
#   Copy-Item env.server.example .env.server
# `.env.server` is ignored by git: never commit it.
# Use it with: docker compose --env-file .env.server up -d --build
# Generated secrets must be plain letters and digits (a hex string is ideal).

# --- Secrets you generate (see docs/04-deployment.md for the PowerShell one-liner) ---------

# SECRET. Password of the PostgreSQL database. Any random hex string.
POSTGRES_PASSWORD=

# SECRET. Password of the S3 storage (the user name is fixed in compose.yaml).
S3_SECRET_ACCESS_KEY=

# SECRET. Signing key of the access tokens, at least 32 characters (use 64 hex characters).
JWT_SECRET=

# SECRET. Bearer token of POST /jobs/due-dates, at least 32 characters.
# The same value goes into the GitHub secret JOBS_TOKEN (used by the hourly cron workflow).
JOBS_TOKEN=

# SECRET. Token of the Cloudflare Tunnel: Zero Trust dashboard > Networks > Tunnels > your
# tunnel > Docker. Copy ONLY the long string after `--token` (it starts with `eyJ`).
TUNNEL_TOKEN=

# --- Secret you get from Google ------------------------------------------------------------

# SECRET. Free key from Google AI Studio (no card). Used for reading scanned documents and
# drafting discrepancy explanations (and for the assistant only if ASSISTANT_LLM_PROVIDER=gemini).
# Embeddings and the assistant's chat do NOT use it here (they run locally in Ollama).
# Remove the leading # and paste the key. Without it (keep the line commented out: an empty
# value is rejected) automatic reading answers 503 and the rest keeps working.
# GEMINI_API_KEY=

# --- Settings (not secret) -----------------------------------------------------------------

# Gemini model for document extraction and discrepancy explanations (and the assistant if it is
# switched to Gemini). Flash-Lite: the free tier of the
# Flash models allows only ~20 requests per day (docs/04-deployment.md, Gemini quota).
GEMINI_MODEL=gemini-3.5-flash-lite

# Models tried in order when GEMINI_MODEL keeps answering 503/429 (empty disables).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash

# Who answers the assistant's chat (ADR-013): `ollama` (local model, default here: no quota, the
# questions never leave the server) or `gemini` (faster, but its free quota is ~20 requests/day).
# ASSISTANT_LLM_PROVIDER=ollama

# Local chat model with tool support. `docker compose up` downloads it once (a few GB).
# Default of the hosted demo: qwen3:4b-instruct (~4.2 GB of RAM, faster on this CPU; ADR-015).
# qwen3:8b (~6.7 GB) passed one more evaluation question on the Mac (ADR-013) but is noticeably
# slower here; it stays selectable per cooperative. WSL2 memory=16GB (docs/04-deployment.md).
# ASSISTANT_OLLAMA_MODEL=qwen3:4b-instruct

# Models each cooperative's administrator can choose in the app (Settings > Asistente IA),
# comma-separated (ADR-014). `ollama-pull` downloads all of them; only installed ones are offered.
# Two models in use at once need ~11 GB of RAM plus embeddings: list a single one on a small host.
# ASSISTANT_OLLAMA_MODELS=qwen3:4b-instruct,qwen3:8b

# Time limit of one call to the local model, in milliseconds (a CPU needs time).
# ASSISTANT_OLLAMA_TIMEOUT_MS=90000

# Messages per user and hour allowed to the assistant.
ASSISTANT_MESSAGE_LIMIT_PER_HOUR=30

# Browser origins allowed by CORS: the GitHub Pages site (origin only, no path, no trailing slash).
CORS_ORIGINS=https://chaparro2001.github.io

# Password of the demo users created by the seed (see docs/sample-data.md). The demo is public:
# choose your own. The seed commands read it; if empty they use the documented default.
SEED_PASSWORD=

# Public URL of the storage, used only for presigned file links (second Cloudflare route to
# storage:9000, see docs/04-deployment.md). Uncomment only to use another hostname.
# S3_PUBLIC_ENDPOINT=https://files-cooperativa.chaparro2001.com

# --- Fixed by compose.yaml (do not set them here) -----------------------------------------
# NODE_ENV=production, DATABASE_URL, S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID,
# S3_FORCE_PATH_STYLE=true, EMBEDDINGS_PROVIDER=ollama, OLLAMA_URL, EMBEDDING_MODEL=bge-m3
# (ASSISTANT_* above have defaults in compose.yaml and can be overridden here).
