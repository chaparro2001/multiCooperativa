{
  "name": "multicooperativa",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @multicooperativa/api test:integration",
    "e2e": "pnpm --filter @multicooperativa/mobile e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "ai:pull": "docker compose exec ollama ollama pull bge-m3",
    "ai:pull:chat": "docker compose exec ollama ollama pull qwen3:8b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
