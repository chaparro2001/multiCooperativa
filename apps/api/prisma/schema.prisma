// Backend data schema. Each module adds its models here;
// no module queries another module's tables (ADR-002).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────── Access and profiles (requirements/01) ─────────────

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum PermissionModule {
  announcements
  assemblies
  documents
  invoicing
  member_area
  assistant
  users
}

enum AccessLevel {
  read
  manage
}

enum PermissionScope {
  own
  all
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Normalized to lowercase (BR-ACC-01).
  email        String   @unique
  /// Null until the user has accepted their first invitation.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  memberships    Membership[]
  sessions       Session[]
  auditsAuthored AuditEvent[] @relation("auditActor")
  auditsReceived AuditEvent[] @relation("auditTarget")
}

model Cooperative {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  cif       String   @unique
  createdAt DateTime @default(now())

  profiles    Profile[]
  memberships Membership[]
  auditEvents AuditEvent[]
}

model Profile {
  id            String  @id @default(uuid()) @db.Uuid
  cooperativeId String  @db.Uuid
  name          String
  /// Predefined profiles are neither edited nor deleted (BR-ACC-13).
  predefined    Boolean @default(false)

  cooperative Cooperative  @relation(fields: [cooperativeId], references: [id])
  permissions Permission[]
  memberships Membership[]

  @@unique([cooperativeId, name])
  // Target of Membership's composite key (BR-ACC-03).
  @@unique([id, cooperativeId])
}

model Permission {
  profileId String           @db.Uuid
  module    PermissionModule
  level     AccessLevel
  scope     PermissionScope  @default(all)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, module])
}

model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  cooperativeId String           @db.Uuid
  profileId     String           @db.Uuid
  status        MembershipStatus @default(invited)
  isPartner     Boolean          @default(false)
  partnerNumber String?
  /// Day the partner joined the cooperative (requirements/06); null falls back to the creation date.
  joinedAt      DateTime?        @db.Date
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  /// Composite key: the profile belongs to the same cooperative (BR-ACC-03).
  profile     Profile     @relation(fields: [profileId, cooperativeId], references: [id, cooperativeId])
  invitation  Invitation?

  // BR-ACC-02 with BR-ACC-14: one live membership per user and cooperative;
  // removed ones are kept and do not prevent a new membership.
  @@unique([userId, cooperativeId], where: raw("status <> 'removed'"))
  @@index([cooperativeId, status])
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  membershipId String    @unique @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  /// Hash of the current refresh token; rotates on every renewal (NFR-ACC-02).
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Failed login attempts for the temporary lockout (BR-ACC-11).
model FailedLoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  email      String
  occurredAt DateTime @default(now())

  @@index([email, occurredAt])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  cooperativeId String   @db.Uuid
  /// Null when the action is run by a platform script.
  actorUserId   String?  @db.Uuid
  targetUserId  String   @db.Uuid
  action        String
  detail        Json
  createdAt     DateTime @default(now())

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  actor       User?       @relation("auditActor", fields: [actorUserId], references: [id])
  target      User        @relation("auditTarget", fields: [targetUserId], references: [id])

  @@index([cooperativeId, createdAt])
}

// ───────────── Member area (requirements/06) ─────────────
// No Prisma relations towards the access tables: only their ids (ADR-002).

enum CapitalMovementType {
  mandatory_contribution
  voluntary_contribution
  refund
  correction
}

/// BR-MEM-01: immutable (a database trigger refuses UPDATE and DELETE); a mistake is
/// corrected with a new movement. Contributions and refunds are positive; a correction
/// carries its own sign (BR-MEM-03). BR-MEM-04: exact decimals.
model CapitalMovement {
  id                     String              @id @default(uuid()) @db.Uuid
  cooperativeId          String              @db.Uuid
  membershipId           String              @db.Uuid
  date                   DateTime            @db.Date
  type                   CapitalMovementType
  concept                String              @db.VarChar(200)
  amount                 Decimal             @db.Decimal(12, 2)
  recordedByMembershipId String              @db.Uuid
  recordedAt             DateTime            @default(now())

  // Statement of a member, and the cooperative's totals.
  @@index([cooperativeId, membershipId, date])
}

// ───────────── Announcements (requirements/02) ─────────────
// No Prisma relations towards the access tables: only their ids (ADR-002).

enum AnnouncementStatus {
  draft
  published
  withdrawn
}

model Announcement {
  id                 String             @id @default(uuid()) @db.Uuid
  cooperativeId      String             @db.Uuid
  authorMembershipId String             @db.Uuid
  title              String             @db.VarChar(120)
  /// Plain text (NFR-ANN-02).
  body               String
  status             AnnouncementStatus @default(draft)
  pinned             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  publishedAt        DateTime?
  editedAt           DateTime?

  attachments AnnouncementAttachment[]
  reads       AnnouncementRead[]

  // Listing: pinned first, then newest to oldest (NFR-ANN-01).
  @@index([cooperativeId, status, pinned, publishedAt])
}

model AnnouncementAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  /// Original name, to display it and for the download.
  name           String
  /// Key in the file storage (ADR-005).
  fileKey        String   @unique
  size           Int
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@index([announcementId])
}

/// BR-ANN-06: one read per member and announcement.
model AnnouncementRead {
  announcementId String   @db.Uuid
  membershipId   String   @db.Uuid
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@id([announcementId, membershipId])
}

// ───────────── Documents (requirements/03) ─────────────

enum DocumentCategory {
  bylaws
  regulations
  minutes
  accounts
  other
}

enum DocumentStatus {
  published
  withdrawn
}

enum IndexingStatus {
  pending
  indexed
  error
  not_indexable
}

model Document {
  id            String           @id @default(uuid()) @db.Uuid
  cooperativeId String           @db.Uuid
  title         String           @db.VarChar(150)
  category      DocumentCategory
  documentDate  DateTime         @db.Date
  status        DocumentStatus   @default(published)
  createdAt     DateTime         @default(now())

  versions DocumentVersion[]
  chunks   DocumentChunk[]

  @@index([cooperativeId, status, category, documentDate])
}

model DocumentVersion {
  id                     String         @id @default(uuid()) @db.Uuid
  documentId             String         @db.Uuid
  /// Key in the file storage (ADR-005).
  fileKey                String         @unique
  /// Original name, for the download.
  fileName               String
  size                   Int
  isCurrent              Boolean
  indexingStatus         IndexingStatus @default(pending)
  indexingError          String?
  uploadedByMembershipId String         @db.Uuid
  uploadedAt             DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id])

  // BR-DOC-03: exactly one current version per document.
  @@unique([documentId], where: raw("\"isCurrent\""))
  @@index([documentId, uploadedAt])
}

/// Indexed chunk for RAG (BR-DOC-06). The embedding is written and queried with SQL (ADR-006).
model DocumentChunk {
  id            String                      @id @default(uuid()) @db.Uuid
  cooperativeId String                      @db.Uuid
  documentId    String                      @db.Uuid
  versionId     String                      @db.Uuid
  page          Int
  /// Order of the chunk within the document.
  position      Int
  content       String
  embedding     Unsupported("vector(1024)")

  document Document @relation(fields: [documentId], references: [id])

  // NFR-DOC-03: the search filters by cooperative before sorting by similarity.
  @@index([cooperativeId])
  @@index([documentId])
}

// ───────────── Assemblies (requirements/04) ─────────────

enum AssemblyType {
  ordinary
  extraordinary
}

enum AssemblyStatus {
  draft
  convened
  held
  cancelled
}

enum Majority {
  simple
  reinforced
}

/// "Pending" has no row: the voting is born when it is opened.
enum VotingStatus {
  open
  closed
}

enum VoteChoice {
  in_favor
  against
  abstention
}

enum CallApplied {
  first
  second
}

enum VotingOutcome {
  approved
  rejected
  no_quorum
}

/// Rules configurable per cooperative (BR-ASM-05, BR-ASM-08, BR-ASM-09). Without a row, the defaults apply.
model AssemblySettings {
  cooperativeId           String @id @db.Uuid
  firstCallQuorumPercent  Int    @default(50)
  secondCallQuorumPercent Int    @default(0)
  reinforcedNumerator     Int    @default(2)
  reinforcedDenominator   Int    @default(3)
  minNoticeDays           Int    @default(15)
}

model Assembly {
  id            String         @id @default(uuid()) @db.Uuid
  cooperativeId String         @db.Uuid
  type          AssemblyType
  status        AssemblyStatus @default(draft)
  firstCallAt   DateTime
  secondCallAt  DateTime?
  place         String         @db.VarChar(200)
  createdAt     DateTime       @default(now())

  /// Last date change of a convened assembly (US-ASM-09): what it was before. All null if never moved.
  previousFirstCallAt  DateTime?
  previousSecondCallAt DateTime?
  previousPlace        String?   @db.VarChar(200)
  rescheduledAt        DateTime?
  rescheduleReason     String?   @db.VarChar(500)

  points AssemblyPoint[]

  @@index([cooperativeId, status, firstCallAt])
}

model AssemblyPoint {
  id          String    @id @default(uuid()) @db.Uuid
  assemblyId  String    @db.Uuid
  /// Position in the agenda, starting at 1.
  position    Int
  title       String    @db.VarChar(200)
  description String
  votable     Boolean
  majority    Majority?

  assembly    Assembly          @relation(fields: [assemblyId], references: [id])
  attachments PointAttachment[]
  voting      Voting?

  @@index([assemblyId, position])
}

model PointAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  pointId   String   @db.Uuid
  name      String
  /// Key in the file storage (ADR-005).
  fileKey   String   @unique
  size      Int
  createdAt DateTime @default(now())

  point AssemblyPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

/// Copies the rules on opening: changing the settings afterwards does not alter a voting in progress.
model Voting {
  id                      String         @id @default(uuid()) @db.Uuid
  pointId                 String         @unique @db.Uuid
  status                  VotingStatus   @default(open)
  majority                Majority
  firstCallQuorumPercent  Int
  secondCallQuorumPercent Int
  reinforcedNumerator     Int
  reinforcedDenominator   Int
  secondCallAvailable     Boolean
  openedAt                DateTime
  closedAt                DateTime?
  /// Result on closing (US-ASM-06).
  inFavor                 Int?
  against                 Int?
  abstentions             Int?
  callApplied             CallApplied?
  quorumReached           Boolean?
  outcome                 VotingOutcome?

  point  AssemblyPoint  @relation(fields: [pointId], references: [id])
  census VotingCensus[]
  votes  Vote[]
}

/// BR-ASM-02: active partners when the voting opens.
model VotingCensus {
  votingId     String @db.Uuid
  membershipId String @db.Uuid

  voting Voting @relation(fields: [votingId], references: [id])
  vote   Vote?

  @@id([votingId, membershipId])
}

/// NFR-ASM-01: one vote per census member and voting, guaranteed by the unique key
/// and by the foreign key to the census (only those present at opening can vote).
model Vote {
  id           String     @id @default(uuid()) @db.Uuid
  votingId     String     @db.Uuid
  membershipId String     @db.Uuid
  choice       VoteChoice
  /// NFR-ASM-03: server time.
  castAt       DateTime   @default(now())

  voting      Voting       @relation(fields: [votingId], references: [id])
  censusEntry VotingCensus @relation(fields: [votingId, membershipId], references: [votingId, membershipId])

  @@unique([votingId, membershipId])
}

// ───────────── Invoices and delivery notes (requirements/05) ─────────────
// Amounts and quantities as Decimal: never floating point (BR-INV-13).

enum Operation {
  purchase
  sale
}

enum DeliveryNoteStatus {
  pending_invoicing
  invoiced
  voided
}

enum PaymentStatus {
  pending
  overdue
  settled
  voided
}

enum ReconciliationStatus {
  no_delivery_notes
  reconciled
  with_discrepancy
}

enum ReminderKind {
  due_soon
  overdue
}

/// Reconciliation tolerance per cooperative (BR-INV-08). Without a row, 1 %.
model InvoicingSettings {
  cooperativeId        String @id @db.Uuid
  toleranceBasisPoints Int    @default(100)
}

model ThirdParty {
  id            String   @id @default(uuid()) @db.Uuid
  cooperativeId String   @db.Uuid
  /// Normalized: uppercase, no spaces or hyphens.
  nif           String   @db.VarChar(9)
  name          String   @db.VarChar(200)
  isSupplier    Boolean
  isCustomer    Boolean
  email         String?
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  deliveryNotes DeliveryNote[]
  invoices      Invoice[]

  /// BR-INV-02: unique per cooperative; another cooperative may have the same tax ID.
  @@unique([cooperativeId, nif])
  @@index([cooperativeId, name])
}

model DeliveryNote {
  id            String             @id @default(uuid()) @db.Uuid
  cooperativeId String             @db.Uuid
  thirdPartyId  String             @db.Uuid
  operation     Operation
  number        String             @db.VarChar(50)
  date          DateTime           @db.Date
  status        DeliveryNoteStatus @default(pending_invoicing)
  invoiceId     String?            @db.Uuid
  fileKey       String?            @unique
  fileName      String?
  createdAt     DateTime           @default(now())

  thirdParty ThirdParty         @relation(fields: [thirdPartyId], references: [id])
  invoice    Invoice?           @relation(fields: [invoiceId], references: [id])
  lines      DeliveryNoteLine[]

  /// BR-INV-04: delivery note number unique per third party.
  @@unique([thirdPartyId, number])
  @@index([cooperativeId, operation, status])
  @@index([invoiceId])
}

model DeliveryNoteLine {
  id             String  @id @default(uuid()) @db.Uuid
  deliveryNoteId String  @db.Uuid
  position       Int
  concept        String  @db.VarChar(200)
  quantity       Decimal @db.Decimal(14, 3)
  unit           String  @db.VarChar(20)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
}

model Invoice {
  id                   String               @id @default(uuid()) @db.Uuid
  cooperativeId        String               @db.Uuid
  thirdPartyId         String               @db.Uuid
  operation            Operation
  number               String               @db.VarChar(50)
  issueDate            DateTime             @db.Date
  dueDate              DateTime             @db.Date
  base                 Decimal              @db.Decimal(12, 2)
  vatRate              Decimal              @db.Decimal(5, 2)
  total                Decimal              @db.Decimal(12, 2)
  paymentStatus        PaymentStatus        @default(pending)
  reconciliationStatus ReconciliationStatus
  settledAt            DateTime?            @db.Date
  fileKey              String?              @unique
  fileName             String?
  createdAt            DateTime             @default(now())

  thirdParty    ThirdParty        @relation(fields: [thirdPartyId], references: [id])
  lines         InvoiceLine[]
  deliveryNotes DeliveryNote[]
  discrepancies Discrepancy[]
  reminders     InvoiceReminder[]

  /// BR-INV-04: received ones unique per supplier; issued ones per cooperative.
  @@unique([thirdPartyId, number], map: "Invoice_received_number_key", where: raw("operation = 'purchase'"))
  @@unique([cooperativeId, number], map: "Invoice_issued_number_key", where: raw("operation = 'sale'"))
  @@index([cooperativeId, operation, paymentStatus, dueDate])
}

model InvoiceLine {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  position  Int
  concept   String  @db.VarChar(200)
  quantity  Decimal @db.Decimal(14, 3)
  unit      String  @db.VarChar(20)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Per-concept detail of a reconciliation with differences (US-INV-04).
model Discrepancy {
  id                String  @id @default(uuid()) @db.Uuid
  invoiceId         String  @db.Uuid
  concept           String  @db.VarChar(200)
  unit              String  @db.VarChar(20)
  deliveredQuantity Decimal @db.Decimal(14, 3)
  invoicedQuantity  Decimal @db.Decimal(14, 3)
  /// Drafted by the AI; the numeric detail is authoritative (BR-INV-12).
  explanation       String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// NFR-INV-04: one notice of each kind per invoice, even if the daily process repeats.
model InvoiceReminder {
  invoiceId String       @db.Uuid
  kind      ReminderKind
  sentOn    DateTime     @db.Date

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@id([invoiceId, kind])
}

// ───────────── AI assistant (requirements/07) ─────────────

enum AssistantRole {
  user
  assistant
}

enum AssistantRating {
  helpful
  not_helpful
}

/// BR-AI-07: stored per membership (user + cooperative); only its author sees it.
model AssistantConversation {
  id            String   @id @default(uuid()) @db.Uuid
  cooperativeId String   @db.Uuid
  membershipId  String   @db.Uuid
  title         String?  @db.VarChar(120)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  messages AssistantMessage[]

  @@index([cooperativeId, membershipId, updatedAt])
}

/// US-AI-07: one row per cooperative that chose a local model; no row means the server default.
model AssistantSetting {
  cooperativeId    String   @id @db.Uuid
  /// Ollama model id picked by the administrator (validated against the server allowlist on write and on use). Null when only a hosted provider is configured.
  model            String?
  /// 'local' (the server's model) or 'hosted' (the cooperative's own provider account, ADR-019).
  source           String   @default("local")
  /// Provider id of the fixed catalog (groq, mistral, nvidia, openrouter); hosted source only.
  hostedProvider   String?
  hostedModel      String?
  /// The cooperative's API key, AES-256-GCM encrypted with ASSISTANT_SECRETS_KEY (base64 parts). Never returned.
  apiKeyCiphertext String?
  apiKeyIv         String?
  apiKeyTag        String?
  /// Last four characters of the key: the only part shown again.
  apiKeyHint       String?
  updatedAt        DateTime @default(now()) @updatedAt
}

/// US-ACC-14: one row per cooperative that customized its look; no row means the app's default theme. Owned by the branding module.
model CooperativeBranding {
  cooperativeId   String   @id @db.Uuid
  /// #RRGGBB upper-case; white text on it reaches WCAG AA (BR-ACC-12).
  primaryColor    String?
  /// Storage key of the logo under cooperatives/<id>/branding/ (BR-ACC-13).
  logoKey         String?
  logoContentType String?
  updatedAt       DateTime @default(now())
}

model AssistantMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           AssistantRole
  content        String
  /// Chunks and records the answer is based on (BR-AI-05).
  citations      Json             @default("[]")
  /// Names of the tools used, never their data (NFR-AI-04).
  tools          Json             @default("[]")
  rating         AssistantRating?
  createdAt      DateTime         @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
