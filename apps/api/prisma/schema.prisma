// Esquema de datos del backend. Cada módulo añade aquí sus modelos;
// ningún módulo consulta las tablas de otro (ADR-002).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────── Acceso y perfiles (requisitos/01) ─────────────

enum MembershipStatus {
  invitada
  activa
  suspendida
  baja
}

enum PermissionModule {
  comunicados
  asambleas
  documentos
  facturas
  area_socio
  asistente
  usuarios
}

enum AccessLevel {
  consulta
  gestion
}

enum PermissionScope {
  propias
  todas
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Normalizado en minúsculas (RN-ACC-01).
  email        String   @unique
  /// Nulo mientras el usuario no haya aceptado su primera invitación.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  memberships    Membership[]
  sessions       Session[]
  auditsAuthored AuditEvent[] @relation("auditActor")
  auditsReceived AuditEvent[] @relation("auditTarget")
}

model Cooperative {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  cif       String   @unique
  createdAt DateTime @default(now())

  profiles    Profile[]
  memberships Membership[]
  auditEvents AuditEvent[]
}

model Profile {
  id            String  @id @default(uuid()) @db.Uuid
  cooperativeId String  @db.Uuid
  name          String
  /// Los perfiles predefinidos no se editan ni se borran (RN-ACC-13).
  predefined    Boolean @default(false)

  cooperative Cooperative  @relation(fields: [cooperativeId], references: [id])
  permissions Permission[]
  memberships Membership[]

  @@unique([cooperativeId, name])
  // Destino de la clave compuesta de Membership (RN-ACC-03).
  @@unique([id, cooperativeId])
}

model Permission {
  profileId String           @db.Uuid
  module    PermissionModule
  level     AccessLevel
  scope     PermissionScope  @default(todas)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, module])
}

model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  cooperativeId String           @db.Uuid
  profileId     String           @db.Uuid
  status        MembershipStatus @default(invitada)
  isPartner     Boolean          @default(false)
  partnerNumber String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  /// Clave compuesta: el perfil pertenece a la misma cooperativa (RN-ACC-03).
  profile     Profile     @relation(fields: [profileId, cooperativeId], references: [id, cooperativeId])
  invitation  Invitation?

  // RN-ACC-02 con RN-ACC-14: una membresía viva por usuario y cooperativa;
  // las de baja se conservan y no impiden una membresía nueva.
  @@unique([userId, cooperativeId], where: raw("status <> 'baja'"))
  @@index([cooperativeId, status])
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  membershipId String    @unique @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  /// Hash del token de refresco vigente; rota en cada renovación (RNF-ACC-02).
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Intentos fallidos de inicio de sesión para el bloqueo temporal (RN-ACC-11).
model FailedLoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  email      String
  occurredAt DateTime @default(now())

  @@index([email, occurredAt])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  cooperativeId String   @db.Uuid
  /// Nulo cuando la acción la ejecuta un script de plataforma.
  actorUserId   String?  @db.Uuid
  targetUserId  String   @db.Uuid
  action        String
  detail        Json
  createdAt     DateTime @default(now())

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  actor       User?       @relation("auditActor", fields: [actorUserId], references: [id])
  target      User        @relation("auditTarget", fields: [targetUserId], references: [id])

  @@index([cooperativeId, createdAt])
}

// ───────────── Comunicados (requisitos/02) ─────────────
// Sin relaciones de Prisma hacia las tablas de acceso: solo sus ids (ADR-002).

enum AnnouncementStatus {
  borrador
  publicado
  retirado
}

model Announcement {
  id                 String             @id @default(uuid()) @db.Uuid
  cooperativeId      String             @db.Uuid
  authorMembershipId String             @db.Uuid
  title              String             @db.VarChar(120)
  /// Texto plano (RNF-COM-02).
  body               String
  status             AnnouncementStatus @default(borrador)
  pinned             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  publishedAt        DateTime?
  editedAt           DateTime?

  attachments AnnouncementAttachment[]
  reads       AnnouncementRead[]

  // Listado: fijados primero y del más reciente al más antiguo (RNF-COM-01).
  @@index([cooperativeId, status, pinned, publishedAt])
}

model AnnouncementAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  /// Nombre original, para mostrarlo y para la descarga.
  name           String
  /// Clave en el almacenamiento de ficheros (ADR-005).
  fileKey        String   @unique
  size           Int
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@index([announcementId])
}

/// RN-COM-06: una lectura por miembro y comunicado.
model AnnouncementRead {
  announcementId String   @db.Uuid
  membershipId   String   @db.Uuid
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@id([announcementId, membershipId])
}

// ───────────── Documentos (requisitos/03) ─────────────

enum DocumentCategory {
  estatutos
  reglamento
  actas
  cuentas
  otros
}

enum DocumentStatus {
  publicado
  retirado
}

enum IndexingStatus {
  pendiente
  indexado
  error
  no_indexable
}

model Document {
  id            String           @id @default(uuid()) @db.Uuid
  cooperativeId String           @db.Uuid
  title         String           @db.VarChar(150)
  category      DocumentCategory
  documentDate  DateTime         @db.Date
  status        DocumentStatus   @default(publicado)
  createdAt     DateTime         @default(now())

  versions DocumentVersion[]
  chunks   DocumentChunk[]

  @@index([cooperativeId, status, category, documentDate])
}

model DocumentVersion {
  id                     String         @id @default(uuid()) @db.Uuid
  documentId             String         @db.Uuid
  /// Clave en el almacenamiento de ficheros (ADR-005).
  fileKey                String         @unique
  /// Nombre original, para la descarga.
  fileName               String
  size                   Int
  isCurrent              Boolean
  indexingStatus         IndexingStatus @default(pendiente)
  indexingError          String?
  uploadedByMembershipId String         @db.Uuid
  uploadedAt             DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id])

  // RN-DOC-03: exactamente una versión vigente por documento.
  @@unique([documentId], where: raw("\"isCurrent\""))
  @@index([documentId, uploadedAt])
}

/// Fragmento indexado para el RAG (RN-DOC-06). El embedding se escribe y se consulta con SQL (ADR-006).
model DocumentChunk {
  id            String                      @id @default(uuid()) @db.Uuid
  cooperativeId String                      @db.Uuid
  documentId    String                      @db.Uuid
  versionId     String                      @db.Uuid
  page          Int
  /// Orden del fragmento dentro del documento.
  position      Int
  content       String
  embedding     Unsupported("vector(1024)")

  document Document @relation(fields: [documentId], references: [id])

  // RNF-DOC-03: la búsqueda filtra por cooperativa antes de ordenar por similitud.
  @@index([cooperativeId])
  @@index([documentId])
}

// ───────────── Asambleas (requisitos/04) ─────────────

enum AssemblyType {
  ordinaria
  extraordinaria
}

enum AssemblyStatus {
  borrador
  convocada
  celebrada
  cancelada
}

enum Majority {
  simple
  reforzada
}

/// «Pendiente» no tiene fila: la votación nace al abrirse.
enum VotingStatus {
  abierta
  cerrada
}

enum VoteChoice {
  a_favor
  en_contra
  abstencion
}

enum CallApplied {
  primera
  segunda
}

enum VotingOutcome {
  aprobado
  rechazado
  sin_quorum
}

/// Reglas configurables por cooperativa (RN-ASA-05, RN-ASA-08, RN-ASA-09). Sin fila, valen los valores por defecto.
model AssemblySettings {
  cooperativeId           String @id @db.Uuid
  firstCallQuorumPercent  Int    @default(50)
  secondCallQuorumPercent Int    @default(0)
  reinforcedNumerator     Int    @default(2)
  reinforcedDenominator   Int    @default(3)
  minNoticeDays           Int    @default(15)
}

model Assembly {
  id            String         @id @default(uuid()) @db.Uuid
  cooperativeId String         @db.Uuid
  type          AssemblyType
  status        AssemblyStatus @default(borrador)
  firstCallAt   DateTime
  secondCallAt  DateTime?
  place         String         @db.VarChar(200)
  createdAt     DateTime       @default(now())

  points AssemblyPoint[]

  @@index([cooperativeId, status, firstCallAt])
}

model AssemblyPoint {
  id          String    @id @default(uuid()) @db.Uuid
  assemblyId  String    @db.Uuid
  /// Orden en el orden del día, desde 1.
  position    Int
  title       String    @db.VarChar(200)
  description String
  votable     Boolean
  majority    Majority?

  assembly    Assembly          @relation(fields: [assemblyId], references: [id])
  attachments PointAttachment[]
  voting      Voting?

  @@index([assemblyId, position])
}

model PointAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  pointId   String   @db.Uuid
  name      String
  /// Clave en el almacenamiento de ficheros (ADR-005).
  fileKey   String   @unique
  size      Int
  createdAt DateTime @default(now())

  point AssemblyPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

/// Copia las reglas al abrir: cambiar los ajustes después no altera una votación en curso.
model Voting {
  id                      String        @id @default(uuid()) @db.Uuid
  pointId                 String        @unique @db.Uuid
  status                  VotingStatus  @default(abierta)
  majority                Majority
  firstCallQuorumPercent  Int
  secondCallQuorumPercent Int
  reinforcedNumerator     Int
  reinforcedDenominator   Int
  secondCallAvailable     Boolean
  openedAt                DateTime
  closedAt                DateTime?
  /// Resultado al cerrar (HU-ASA-06).
  inFavor                 Int?
  against                 Int?
  abstentions             Int?
  callApplied             CallApplied?
  quorumReached           Boolean?
  outcome                 VotingOutcome?

  point  AssemblyPoint  @relation(fields: [pointId], references: [id])
  census VotingCensus[]
  votes  Vote[]
}

/// RN-ASA-02: socios activos al abrir la votación.
model VotingCensus {
  votingId     String @db.Uuid
  membershipId String @db.Uuid

  voting Voting @relation(fields: [votingId], references: [id])
  vote   Vote?

  @@id([votingId, membershipId])
}

/// RNF-ASA-01: un voto por censado y votación, garantizado por la clave única
/// y por la clave foránea al censo (solo vota quien estaba al abrir).
model Vote {
  id           String     @id @default(uuid()) @db.Uuid
  votingId     String     @db.Uuid
  membershipId String     @db.Uuid
  choice       VoteChoice
  /// RNF-ASA-03: hora del servidor.
  castAt       DateTime   @default(now())

  voting       Voting       @relation(fields: [votingId], references: [id])
  censusEntry  VotingCensus @relation(fields: [votingId, membershipId], references: [votingId, membershipId])

  @@unique([votingId, membershipId])
}

// ───────────── Facturas y albaranes (requisitos/05) ─────────────
// Importes y cantidades en Decimal: nunca coma flotante (RN-FAC-13).

enum Operation {
  compra
  venta
}

enum DeliveryNoteStatus {
  pendiente_facturar
  facturado
  anulado
}

enum PaymentStatus {
  pendiente
  vencida
  liquidada
  anulada
}

enum ReconciliationStatus {
  sin_albaranes
  conciliada
  con_discrepancia
}

enum ReminderKind {
  proxima_a_vencer
  vencida
}

/// Tolerancia de conciliación por cooperativa (RN-FAC-08). Sin fila, 1 %.
model InvoicingSettings {
  cooperativeId        String @id @db.Uuid
  toleranceBasisPoints Int    @default(100)
}

model ThirdParty {
  id            String   @id @default(uuid()) @db.Uuid
  cooperativeId String   @db.Uuid
  /// Normalizado: mayúsculas, sin espacios ni guiones.
  nif           String   @db.VarChar(9)
  name          String   @db.VarChar(200)
  isSupplier    Boolean
  isCustomer    Boolean
  email         String?
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  deliveryNotes DeliveryNote[]
  invoices      Invoice[]

  /// RN-FAC-02: único por cooperativa; otra cooperativa puede tener el mismo NIF.
  @@unique([cooperativeId, nif])
  @@index([cooperativeId, name])
}

model DeliveryNote {
  id            String             @id @default(uuid()) @db.Uuid
  cooperativeId String             @db.Uuid
  thirdPartyId  String             @db.Uuid
  operation     Operation
  number        String             @db.VarChar(50)
  date          DateTime           @db.Date
  status        DeliveryNoteStatus @default(pendiente_facturar)
  invoiceId     String?            @db.Uuid
  fileKey       String?            @unique
  fileName      String?
  createdAt     DateTime           @default(now())

  thirdParty ThirdParty         @relation(fields: [thirdPartyId], references: [id])
  invoice    Invoice?           @relation(fields: [invoiceId], references: [id])
  lines      DeliveryNoteLine[]

  /// RN-FAC-04: número de albarán único por tercero.
  @@unique([thirdPartyId, number])
  @@index([cooperativeId, operation, status])
  @@index([invoiceId])
}

model DeliveryNoteLine {
  id             String  @id @default(uuid()) @db.Uuid
  deliveryNoteId String  @db.Uuid
  position       Int
  concept        String  @db.VarChar(200)
  quantity       Decimal @db.Decimal(14, 3)
  unit           String  @db.VarChar(20)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
}

model Invoice {
  id                   String               @id @default(uuid()) @db.Uuid
  cooperativeId        String               @db.Uuid
  thirdPartyId         String               @db.Uuid
  operation            Operation
  number               String               @db.VarChar(50)
  issueDate            DateTime             @db.Date
  dueDate              DateTime             @db.Date
  base                 Decimal              @db.Decimal(12, 2)
  vatRate              Decimal              @db.Decimal(5, 2)
  total                Decimal              @db.Decimal(12, 2)
  paymentStatus        PaymentStatus        @default(pendiente)
  reconciliationStatus ReconciliationStatus
  settledAt            DateTime?            @db.Date
  fileKey              String?              @unique
  fileName             String?
  createdAt            DateTime             @default(now())

  thirdParty    ThirdParty        @relation(fields: [thirdPartyId], references: [id])
  lines         InvoiceLine[]
  deliveryNotes DeliveryNote[]
  discrepancies Discrepancy[]
  reminders     InvoiceReminder[]

  /// RN-FAC-04: las recibidas, únicas por proveedor; las emitidas, por cooperativa.
  @@unique([thirdPartyId, number], map: "Invoice_received_number_key", where: raw("operation = 'compra'"))
  @@unique([cooperativeId, number], map: "Invoice_issued_number_key", where: raw("operation = 'venta'"))
  @@index([cooperativeId, operation, paymentStatus, dueDate])
}

model InvoiceLine {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  position  Int
  concept   String  @db.VarChar(200)
  quantity  Decimal @db.Decimal(14, 3)
  unit      String  @db.VarChar(20)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Detalle por concepto de una conciliación con diferencias (HU-FAC-04).
model Discrepancy {
  id                String  @id @default(uuid()) @db.Uuid
  invoiceId         String  @db.Uuid
  concept           String  @db.VarChar(200)
  unit              String  @db.VarChar(20)
  deliveredQuantity Decimal @db.Decimal(14, 3)
  invoicedQuantity  Decimal @db.Decimal(14, 3)
  /// Redactada por IA; el detalle numérico es el que manda (RN-FAC-12).
  explanation       String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// RNF-FAC-04: un aviso de cada tipo por factura, aunque el proceso diario se repita.
model InvoiceReminder {
  invoiceId String       @db.Uuid
  kind      ReminderKind
  sentOn    DateTime     @db.Date

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@id([invoiceId, kind])
}
